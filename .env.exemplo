# Copie este arquivo para ".env" (na mesma pasta) e preencha com SUAS credenciais.
# O arquivo .env está no .gitignore e nunca deve ser versionado.

# Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=sua-chave-do-google-ai-studio

# Trello (https://trello.com/power-ups/admin) — veja o README
TRELLO_API_KEY=sua-api-key-do-trello
TRELLO_API_SECRET=seu-api-secret-do-trello
TRELLO_TOKEN=seu-token-do-trello
TRELLO_BOARD_NAME=nome-exato-do-seu-board

# Opcionais
# GEMINI_MODEL=gemini-3.8-flash
# AGENT_TIMEZONE=America/Sao_Paulo
